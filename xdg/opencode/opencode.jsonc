{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:26b": {
          "name": "Gemma 4 26B",
          "limit": { "context": 262144, "output": 16384 }
        },
        "qwen3.6:35b": {
          "name": "Qwen 3.6 35B",
          "limit": { "context": 262144, "output": 16384 }
        },
        "qwen3.6:35b-coding": {
          "name": "Qwen 3.6 35B - Coding",
          "limit": { "context": 262144, "output": 16384 }
        }
      }
    }
  }
}
